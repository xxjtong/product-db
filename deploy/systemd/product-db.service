# 生产主服务单元（版本化于 R35；R51 加安全加固）
#
# 安装位置：/etc/systemd/system/product-db.service（root 属主，改后需
#   sudo systemctl daemon-reload && sudo systemctl restart product-db）
# 内容与生产实际运行的一致；此前只以文档内联代码块存在，改错了没人能发现。
# 更新方式：`sudo bash deploy/install-systemd-unit.sh`（幂等、带备份与回滚）
[Unit]
Description=Product DB Backend
After=network.target
# 崩溃循环上限：300 秒内最多重启 20 次，超过则进入 failed 状态而**不再无限重启**
# （systemd 默认 10 秒 / 5 次，太紧，正常抖动就可能触顶；这里放宽次数、拉长窗口）
# 注意 StartLimit* 必须写在 [Unit] 段（systemd ≥ 229）
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=tong
Group=tong
WorkingDirectory=/opt/product-db/backend
Environment=PATH=/opt/product-db/backend/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/product-db/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# 停止超时：默认 90s 太长，缩短到 25s —— 卡住时能更快完成重启
# （uvicorn 正常退出 <2s；强杀对 SQLite WAL 是安全的）
TimeoutStopSec=25

# --- 安全加固（R51）---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# ⚠️ 不要加 ProtectHome=true：生产数据库的真实路径在 /home/tong/product-db/backend/
# （config.py 的 DATABASE_URL 默认值；.env 里的 DATABASE_PATH=/opt/... 并未生效 —— 见 R51），
# 启用后 /home 被隐藏 → SQLite 打不开库 → 所有查库接口 500。
# 待数据库迁到 /opt 后再开（迁移需单独评估：停机 + 数据搬迁 + 改配置）。
# ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
# 只允许 IPv4/IPv6/Unix/Netlink 套接字（AF_NETLINK 保留给 DNS 解析等内核查询）
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
